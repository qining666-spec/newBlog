generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nickname     String
  avatar       String?
  passwordHash String?
  oauthProvider String?
  oauthId      String?
  preferences  String   @default("{}")
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts      BlogPost[]
  bookmarks      Bookmark[]
  readingProgress ReadingProgress[]
  nesSaveStates  NesSaveState[]
  nesGames       NesGame[]
  aiConversations AiConversation[]
  aiKnowledge    AiKnowledge[]

  @@index([email])
}

model Novel {
  id         String   @id @default(cuid())
  title      String
  author     String
  source     String
  sourceUrl  String?
  coverImage String?
  isFavorite Boolean  @default(false)
  userId     String   @default("anonymous")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapters       Chapter[]
  bookmarks      Bookmark[]
  readingProgress ReadingProgress[]

  @@index([userId])
}

model Chapter {
  id            String   @id @default(cuid())
  novelId       String
  chapterNumber Int
  title         String
  content       String
  wordCount     Int
  createdAt     DateTime @default(now())

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, chapterNumber])
  @@index([novelId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  chapterId String
  position  Int
  note      String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([userId, novelId])
}

model ReadingProgress {
  id                  String   @id @default(cuid())
  userId              String
  novelId             String
  currentChapterId    String
  currentScrollPosition Float   @default(0)
  lastReadAt          DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  coverImage  String?
  userId      String
  categoryId  String?
  tags        String
  isPublished Boolean  @default(false)
  isPrivate   Boolean  @default(false)
  viewCount   Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  userId      String
  createdAt   DateTime @default(now())

  posts BlogPost[]

  @@unique([userId, slug])
  @@index([userId])
}

model NesGame {
  id          String   @id @default(cuid())
  title       String
  romPath     String
  coverImage  String?
  description String?
  uploadedBy  String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saveStates NesSaveState[]
  uploader   User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
  @@index([isPublic])
}

model NesSaveState {
  id         String   @id @default(cuid())
  gameId     String
  userId     String
  saveData   String
  screenshot String?
  createdAt  DateTime @default(now())

  game NesGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, userId])
}

model GomokuRoom {
  id        String   @id @default(cuid())
  name      String
  hostId    String
  guestId   String?
  status    String   @default("waiting")
  boardSize Int      @default(15)
  winner    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VideoItem {
  id           String    @id @default(cuid())
  title        String
  url          String
  platform     String
  thumbnail    String?
  userId       String    @default("anonymous")
  isFavorite   Boolean   @default(false)
  lastWatchedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([isFavorite])
}

model ChatMessage {
  id           String   @id @default(cuid())
  roomId       String
  senderId     String
  senderName   String
  senderAvatar String?
  type         String   @default("text")
  content      String
  createdAt    DateTime @default(now())

  @@index([roomId, createdAt])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String   @default("anonymous")
  title     String
  model     String
  messages  String
  config    String   @default("{}")
  knowledge String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

model AiKnowledge {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  tags      String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
